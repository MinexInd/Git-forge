<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup is false in the manifest because repositories and the encrypted
  credential store must not be copied off-device by the backup framework.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
