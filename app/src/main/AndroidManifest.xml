<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access is required for GitHub and for cloning/pushing over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The GitHub device flow shows a floating window that stays visible while the
      user types the code in a browser, so sign-in completes without the app needing
      to be in the foreground. SYSTEM_ALERT_WINDOW is what allows that window to draw
      over other apps; if the user declines it the flow falls back to an in-app
      dialog and still works.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Lets the in-app updater hand a verified APK to the Android package installer.
      Without this declaration canRequestPackageInstalls() is always false and the
      "install unknown apps" screen cannot be opened, so updates would be impossible.
      Android still shows its own install confirmation; this grants no silent install.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      The app deliberately requests no broad storage permission. All repositories live in
      app-private storage and user file import/export goes through the Storage Access
      Framework, which needs no manifest permission.
    -->

    <application
        android:name=".GitForgeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GitForge.Splash"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.GitForge.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Runs the GitHub device flow in a floating window that outlives the activity.
          Not exported: only GitForge can start it.
        -->
        <service
            android:name=".ui.auth.GitHubAuthOverlayService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          WorkManager is initialised on demand (see GitForgeApplication) rather than by the
          default provider, so nothing runs before the app is fully configured.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove" />

        <!--
          Exposes only the updater's staged APK to the system package installer. The
          grant is per-URI and read-only; repositories and credentials are not shared.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>
